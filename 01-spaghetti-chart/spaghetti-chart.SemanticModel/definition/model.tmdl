model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-150
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Settings for your own data: folder, file, which CSV columns to use, display order and Top N. DataFolder is the only place a path appears.
queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

/// Staging queries with load disabled, reused by the tables below.
queryGroup Staging

	annotation PBI_QueryGroupOrder = 1

/// Dimension tables: descriptions, labels and sort keys.
queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 2

/// Fact tables: keys and numbers.
queryGroup Facts

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DataFolder","DataFile","DateColumn","Group1Column","Group2Column","ValueColumn","Group1Order","Group2Order","TopN","Source_Sales","fnGroupOrder","Dim_Series","Dim_TopN","Fact_Sales"]

ref table _Measures
ref table Fact_Sales
ref table Dim_Date
ref table Dim_Series
ref table Dim_TopN

ref cultureInfo en-US

