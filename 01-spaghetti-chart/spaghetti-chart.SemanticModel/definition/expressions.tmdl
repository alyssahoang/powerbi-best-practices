/// How many lines the "Top N + Others" chart keeps; every other line is averaged into "Others".
expression TopN = 5 meta [IsParameterQuery=true, Type="Number", IsParameterQueryRequired=true]
	lineageTag: 01666cbd-35d7-466e-83b4-0e933a21a98c
	queryGroup: Parameters

	annotation PBI_ResultType = Number

/// Helper function, load disabled. Returns the distinct values of one grouping column in display order: the values listed in an order parameter first, then every other value by latest-year total, largest first.
expression fnGroupOrder =
		(rows as table, columnName as text, explicitOrder as nullable text) as list =>
		let
		    LatestYear = List.Max(List.Transform(rows[Month], Date.Year)),
		    LatestRows = Table.SelectRows(rows, each Date.Year([Month]) = LatestYear),
		    Totals = Table.Group(LatestRows, {columnName}, {{"Total", each List.Sum([Sales]), type number}}),
		    ByTotal = Table.Column(Table.Sort(Totals, {{"Total", Order.Descending}}), columnName),
		    AllValues = List.Distinct(Table.Column(rows, columnName)),
		    Listed = if explicitOrder = null then {} else List.Select(List.Transform(Text.Split(explicitOrder, ","), Text.Trim), each _ <> "" and List.Contains(AllValues, _)),
		    Ordered = List.Distinct(Listed & ByTotal & AllValues)
		in
		    Ordered
	lineageTag: 58d9a60f-e2b1-446a-a76e-d94c9dd94b3b
	queryGroup: Staging

	annotation PBI_ResultType = Function

