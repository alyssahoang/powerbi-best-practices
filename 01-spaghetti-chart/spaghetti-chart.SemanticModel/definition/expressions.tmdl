/// Optional display order of the first grouping, comma separated. Leave empty to order by latest-year total, largest first. Values you do not list follow, by total.
expression Group1Order = "Online, In-store, Wholesale" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=false]
	lineageTag: 28b665f4-188a-4ccf-9d93-139480c4c42e
