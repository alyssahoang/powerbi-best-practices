/// Folder that holds your CSV file, ending with a backslash. The only place a path appears in the model.
expression DataFolder = "C:\powerbi-best-practices\01-spaghetti-chart\data\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 1bd46651-d180-4af7-9c7d-5678cf1046f1
	queryGroup: Parameters

	annotation PBI_ResultType = Text

/// Staging query, load disabled. Reads your CSV, maps your four columns onto the model's names (Month, Channel, Region, Sales), sets types, drops incomplete rows and adds the combined Series label every table below reuses.
expression Source_Sales =
		let
		    Source = Csv.Document(File.Contents(DataFolder & DataFile), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    #"Map Columns To Model Names" = Table.FromColumns(
		        {
		            Table.Column(#"Promoted Headers", DateColumn),
		            Table.Column(#"Promoted Headers", Group1Column),
		            Table.Column(#"Promoted Headers", Group2Column),
		            Table.Column(#"Promoted Headers", ValueColumn)
		        },
		        {"Month", "Channel", "Region", "Sales"}
		    ),
		    #"Set Data Types" = Table.TransformColumnTypes(#"Map Columns To Model Names", {{"Month", type date}, {"Channel", type text}, {"Region", type text}, {"Sales", type number}}, "en-US"),
		    #"Trim Group Names" = Table.TransformColumns(#"Set Data Types", {{"Channel", Text.Trim, type text}, {"Region", Text.Trim, type text}}),
		    #"Remove Incomplete Rows" = Table.SelectRows(#"Trim Group Names", each [Month] <> null and [Channel] <> null and [Channel] <> "" and [Region] <> null and [Region] <> "" and [Sales] <> null),
		    #"Add Series Label" = Table.AddColumn(#"Remove Incomplete Rows", "Series", each [Channel] & ", " & [Region], type text)
		in
		    #"Add Series Label"
	lineageTag: 29b8bfe3-04e3-4f09-a668-64755652b43b
	queryGroup: Staging

	annotation PBI_ResultType = Table

